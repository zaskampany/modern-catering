# Contact & social config — copy to .env.local and fill in.
# All must be prefixed NEXT_PUBLIC_ so client components can read them.

NEXT_PUBLIC_PHONE_PRIMARY=+919447268441
NEXT_PUBLIC_PHONE_SECONDARY=464646
NEXT_PUBLIC_EMAIL=moderncatering1997@gmail.com
NEXT_PUBLIC_WHATSAPP=919447268441
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/moderncatering
NEXT_PUBLIC_INSTAGRAM_REELS=https://www.instagram.com/moderncatering/reels/
NEXT_PUBLIC_FACEBOOK=https://facebook.com/moderncatering
NEXT_PUBLIC_ADDRESS_LINE1=Sivagiri Nagar, Doctor Padi
NEXT_PUBLIC_ADDRESS_LINE2=Kolazhy, Thrissur, Kerala
NEXT_PUBLIC_ADDRESS_SHORT=Kolazhy, Thrissur, Kerala

# ---- Onam (seasonal promo: homepage strip + popup + /onam page) ----
# These are read at BUILD time, so rebuild/redeploy after changing any of them.

# no  = hide the strip, popup and booking everywhere (accepts yes/no/true/false)
NEXT_PUBLIC_ONAM_ENABLED=yes

# yes = keep /onam up but swap the form for a "fully booked" message
NEXT_PUBLIC_ONAM_SOLD_OUT=no

# yes = popup on every page load; no = once per browser session
NEXT_PUBLIC_ONAM_POPUP_EVERY_VISIT=no

# Last day the promo shows, inclusive — set this to Thiruvonam day. After it
# passes the strip and popup disappear on their own, with no redeploy needed.
NEXT_PUBLIC_ONAM_UNTIL=2026-09-26
NEXT_PUBLIC_ONAM_YEAR=2026

# The day sadhya is collected (Thiruvonam). There is no delivery. YYYY-MM-DD.
# Shown on the /onam page and on the booking form.
NEXT_PUBLIC_ONAM_COLLECTION_DATE=2026-08-26

# yes = show the raw embedded Google Form instead of the themed on-site form.
# The themed form posts to the same place; switch only if its field ids drift.
NEXT_PUBLIC_ONAM_FORM_EMBED=no

# Google Form share link (docs.google.com/forms/... — a forms.gle short link
# can't be embedded, so paste the long one). This is where bookings are stored.
NEXT_PUBLIC_ONAM_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSetXqicFZmnfz2hsVAiICzdf5OoVaVFVlSFZVtre41kQLuC-w/viewform

# Payasam is ordered separately, so it needs its own Google Form (the sadhya
# form makes the package count required). Questions: Name, Phone, Payasam
# (long text), Special Instructions. Paste the long docs.google.com link.
NEXT_PUBLIC_ONAM_PAYASAM_FORM_URL=

# Sadhya price and the payasam add-on rate, straight off the poster.
NEXT_PUBLIC_ONAM_SADHYA_PRICE=2800
NEXT_PUBLIC_ONAM_SADHYA_SERVES=5
NEXT_PUBLIC_ONAM_PAYASAM_PRICE=270

# Collection point, timings and the booking line printed on the poster.
NEXT_PUBLIC_ONAM_PICKUP=Modern Catering, Kolazhy, Doctor Padi
NEXT_PUBLIC_ONAM_SADHYA_TIME=11:00 am – 12:30 pm
NEXT_PUBLIC_ONAM_PAYASAM_TIME=From 7:00 am
NEXT_PUBLIC_ONAM_BOOKING_PHONE=+919497843441
NEXT_PUBLIC_ONAM_ON_SWIGGY=yes
NEXT_PUBLIC_ONAM_ON_ZOMATO=yes

# ---- Location map ----
# Google Maps > Share > "Embed a map" > copy the src="..." out of the iframe.
# A plain /maps/place/ or goo.gl link will NOT load in an iframe; leave blank
# and the address query below is used instead (works, needs no API key).
NEXT_PUBLIC_MAP_EMBED_URL=

# Where "Get directions" points. Blank = a Maps search for the address.
NEXT_PUBLIC_MAP_LINK=

# Overrides the address used for the fallback map and directions search.
NEXT_PUBLIC_MAP_QUERY=Modern Catering, Kolazhy, Doctor Padi, Thrissur, Kerala

# "lat,lng" — pins the map exactly, rather than approximating from the address.
# Open the place in Google Maps and read the numbers after the @ in the URL.
NEXT_PUBLIC_MAP_COORDS=10.5753675,76.2190012
